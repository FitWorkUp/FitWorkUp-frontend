<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões de Foreground Service (Android 9+ e Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- Permissões de Sensores e Localização -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FitWorkUpApp"
        android:allowBackup="false"
        android:icon="@drawable/corrida"
        android:label="@string/app_name"
        android:roundIcon="@drawable/corrida"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitWorkUp"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Metadado do Google Maps -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!--
            O WorkManager usa a configuração fornecida por FitWorkUpApp para
            injetar o HiltWorkerFactory. Remove apenas a inicialização automática
            duplicada; os demais componentes do AndroidX Startup são preservados.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FitWorkUp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🔒 DECLARAÇÃO DO SERVIÇO COM OS TIPOS ESPECÍFICOS EXIGIDOS PELO ANDROID 14+ -->
        <service
            android:name=".service.WorkoutSensorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location|health" />

    </application>

</manifest>
